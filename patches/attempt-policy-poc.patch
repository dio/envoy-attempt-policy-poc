+
+extern "C" bool envoy_dynamic_module_callback_http_attempt_policy_poc(void* raw, uint64_t token,
+                                                                     uintptr_t callback) {
+  auto* filter = static_cast<Envoy::Extensions::DynamicModules::HttpFilters::DynamicModuleHttpFilter*>(raw);
+  auto* info = filter->streamInfo();
+  if (!info || !token || !callback ||
+      info->filterState()->hasDataWithName(Envoy::Router::AttemptPolicy::Key)) {
+    return false;
+  }
+  info->filterState()->setData(
+      Envoy::Router::AttemptPolicy::Key,
+      std::make_shared<Envoy::Router::AttemptPolicy>(
+          token, reinterpret_cast<Envoy::Router::AttemptPolicy::Callback>(callback)),
+      Envoy::StreamInfo::FilterState::LifeSpan::Request);
+  return true;
+}
