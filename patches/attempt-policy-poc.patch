+RetryStatus RetryStateImpl::configuredRetry(uint32_t reason, uint32_t status, DoRetryCallback callback) {
+  const uint64_t decision = attempt_policy_->decide(reason, status);
+  if (decision == 0 || decision > 600001) { return RetryStatus::No; }
+  configured_delay_ = std::chrono::milliseconds(decision - 1);
+  return shouldRetry(decision == 1 ? RetryDecision::RetryImmediately : RetryDecision::RetryWithBackoff, callback);
