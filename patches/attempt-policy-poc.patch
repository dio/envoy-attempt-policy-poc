new file mode 100644
index 00000000..ae94aff5
--- /dev/null
+++ b/source/common/router/attempt_policy.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include <cstdint>
+
+#include "envoy/stream_info/filter_state.h"
+
+namespace Envoy {
+namespace Router {
+
+// Experimental PoC interface, not a proposed stable dynamic-module ABI.
+class AttemptPolicy : public StreamInfo::FilterState::Object {
+public:
+  using Callback = uint64_t (*)(uint64_t, uint32_t, uint32_t);
+  static constexpr const char* Key = "envoy.router.attempt_policy_poc";
+  AttemptPolicy(uint64_t token, Callback callback) : token_(token), callback_(callback) {}
+  // Zero denies; otherwise delay in milliseconds plus one. Called on the worker.
+  uint64_t decide(uint32_t reason, uint32_t status) const { return callback_(token_, reason, status); }
+  const uint64_t token_;
+  const Callback callback_;
+};
+
+} // namespace Router
+} // namespace Envoy
